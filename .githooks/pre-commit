#!/bin/sh
# Regenerates docs/STATUS.md and docs/TIMELINE.md, stages them, then runs
# track.py check. gitleaks is added here in B0.5.1.
# Enable with: git config core.hooksPath .githooks
set -e
root="$(git rev-parse --show-toplevel)"
# sync reads the working tree, so it must match what is being committed.
if ! git -C "$root" diff --quiet -- docs/plan docs/DECISIONS.md; then
  echo "✗ docs/plan or docs/DECISIONS.md has unstaged changes; stage or stash them first" >&2
  exit 1
fi
python3 "$root/tools/track.py" sync >/dev/null
git add "$root/docs/STATUS.md" "$root/docs/TIMELINE.md"
python3 "$root/tools/track.py" check --pre-commit
